{
  "name": "startline-mobile-app",
  "version": "0.1.0",
  "private": true,
  "description": "Startline for iOS and Android: a Capacitor shell around startlineau.com.",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "sync:dev": "cross-env CAP_ENV=dev cap sync",
    "sync:staging": "cross-env CAP_ENV=staging cap sync",
    "sync:prod": "cross-env CAP_ENV=prod cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "assets": "capacitor-assets generate --android --ios --iconBackgroundColor \"#141414\" --iconBackgroundColorDark \"#141414\" --splashBackgroundColor \"#141414\" --splashBackgroundColorDark \"#141414\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.9.0"
  }
}
